{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daag",
  "version": "1.3.0",
  "identifier": "com.asifm91.daag",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "দাগ — Daag",
        "width": 1100,
        "height": 850,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/asifm91/daag/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNTM0MUZERTc1OEQ4MUYKUldRZjJGam4vVUZUdnREbUlaaElhQ0JBTDRXOGFOZTR5RVQ3cnBKQjViMUVKMlFhbHFzcDBqc3gK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Asif Mahmood",
    "copyright": "Copyright © 2026 Asif Mahmood",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "Hassle-free PDF annotation",
    "longDescription": "Daag is a local-first desktop PDF annotator that autosaves annotations straight into the PDF file on disk every few seconds, so a reload or crash can't silently lose your work.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
