{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pdf-annotator",
  "version": "0.1.0",
  "identifier": "com.example.pdfannotator",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Annotator",
        "width": 1100,
        "height": 850,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
